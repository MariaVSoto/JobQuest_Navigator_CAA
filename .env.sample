# JobQuest Navigator Environment Configuration Sample
# Copy this file to .env and update the values according to your environment

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Application Name
APP_NAME=JobQuest Navigator

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# React App Configuration
REACT_APP_API_BASE_URL=http://localhost:8000/api
REACT_APP_GRAPHQL_ENDPOINT=http://localhost:8000/graphql/

# Development Features
REACT_APP_DEV_AUTH_BYPASS=true
GENERATE_SOURCEMAP=true

# External API Keys
REACT_APP_ADZUNA_API_ID=your_adzuna_api_id_here
REACT_APP_ADZUNA_API_KEY=your_adzuna_api_key_here
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-django-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# SQLite (Development - Default)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (Production/Docker)
# DATABASE_URL=postgresql://user:password@localhost:5432/jobquest_db
POSTGRES_DB=jobquest_db
POSTGRES_USER=jobquest_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# OpenAI API (for AI suggestions)
OPENAI_API_KEY=your_openai_api_key_here

# Adzuna Job API
ADZUNA_API_ID=your_adzuna_api_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# Google Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AWS Configuration (for production deployment)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=jobquest-storage

# =============================================================================
# DOCKER DEVELOPMENT CONFIGURATION
# =============================================================================

# PostgreSQL (Docker)
DOCKER_POSTGRES_DB=jobquest_db
DOCKER_POSTGRES_USER=jobquest_user
DOCKER_POSTGRES_PASSWORD=docker_dev_password
DOCKER_POSTGRES_HOST=postgres
DOCKER_POSTGRES_PORT=5432

# Redis (Docker)
DOCKER_REDIS_URL=redis://redis:6379/0

# MinIO S3-Compatible Storage (Docker)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=jobquest-resumes
MINIO_USE_SSL=false

# LocalStack AWS Services Emulation (Docker)
LOCALSTACK_ENDPOINT=http://localstack:4566
LOCALSTACK_ACCESS_KEY=test
LOCALSTACK_SECRET_KEY=test
LOCALSTACK_REGION=us-east-1
LOCALSTACK_S3_BUCKET=jobquest-storage

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email Backend (for development use console, for production use SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Configuration (for production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_email_password

# MailHog (Docker Development)
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

# =============================================================================
# CORS AND SECURITY
# =============================================================================

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Sentry (Error Monitoring)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test Database
TEST_DATABASE_URL=sqlite:///test_db.sqlite3

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Zappa/Lambda Configuration
ZAPPA_STAGE=development
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY_SIZE=512

# CloudFormation Stack Names
CF_STACK_NAME=jobquest-infrastructure
CF_BACKEND_STACK=jobquest-backend
CF_FRONTEND_STACK=jobquest-frontend

# Domain Configuration
DOMAIN_NAME=your-domain.com
SUBDOMAIN_API=api.your-domain.com
SUBDOMAIN_APP=app.your-domain.com

# SSL Certificate ARN (AWS)
SSL_CERTIFICATE_ARN=arn:aws:acm:region:account:certificate/certificate-id

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Hot Reload
CHOKIDAR_USEPOLLING=true

# Source Maps
GENERATE_SOURCEMAP=true

# Bundle Analyzer
ANALYZE_BUNDLE=false

# =============================================================================
# API RATE LIMITING
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
FEATURE_AI_SUGGESTIONS=true
FEATURE_REAL_TIME_JOBS=true
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_PREMIUM_FEATURES=false

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit this file with real API keys or passwords to version control
# 2. For production, use environment-specific values
# 3. Some values are intentionally left empty - fill them based on your setup
# 4. Docker values are used when running with docker-compose
# 5. AWS values are needed for production deployment only
# 6. External API keys are optional but recommended for full functionality