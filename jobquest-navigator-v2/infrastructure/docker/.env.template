# JobQuest Navigator v2 Docker Environment Configuration
# Copy this file to .env and update with your values

# ===== DATABASE SETTINGS =====
POSTGRES_DB="jobquest_navigator_v2"
POSTGRES_USER="jobquest_user"
POSTGRES_PASSWORD="jobquest_password_2024"
POSTGRES_HOST="db"
POSTGRES_PORT="5432"

# Database external port (host machine)
DB_EXTERNAL_PORT="5433"

# ===== REDIS SETTINGS =====
REDIS_PASSWORD="jobquest_redis_2024"
REDIS_HOST="redis"
REDIS_PORT="6379"

# Redis external port (host machine)
REDIS_EXTERNAL_PORT="6380"

# ===== APPLICATION PORTS =====
# Backend FastAPI service
BACKEND_PORT="8001"
BACKEND_INTERNAL_PORT="8000"

# Frontend React service
FRONTEND_PORT="3001"
FRONTEND_INTERNAL_PORT="3000"

# ===== MINIO STORAGE SETTINGS =====
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin123"
MINIO_ENDPOINT="minio:9000"

# MinIO external ports (host machine)
MINIO_API_PORT="9001"
MINIO_CONSOLE_PORT="9002"

# Storage bucket
MINIO_BUCKET_NAME="jobquest-resumes"

# ===== DEVELOPMENT SETTINGS =====
# Docker Compose profiles
COMPOSE_PROFILES="core"  # Options: core, storage, development, production

# Volume settings
ENABLE_VOLUME_MOUNTS=true

# ===== NETWORKING =====
# Docker network name
NETWORK_NAME="jobquest_v2_network"

# ===== LOGGING =====
LOG_LEVEL="INFO"  # Options: DEBUG, INFO, WARNING, ERROR

# ===== BACKUP SETTINGS =====
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM