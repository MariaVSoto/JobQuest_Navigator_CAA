# JobQuest Navigator v2 - Frontend Configuration
# Copy to .env.local for local development

# API Configuration
REACT_APP_GRAPHQL_URL=http://localhost:8001/graphql
REACT_APP_USE_FASTAPI_JOBS=true
REACT_APP_USE_FASTAPI_AUTH=true

# Environment
REACT_APP_ENV=development
REACT_APP_DEBUG_MODE=true

# Development Bypass (for testing without authentication)
REACT_APP_DEV_AUTH_BYPASS=false

# Security Configuration
# Enable secure authentication with HttpOnly cookies (prevents XSS attacks)
REACT_APP_USE_SECURE_AUTH=false

# Service Configuration
REACT_APP_USE_GRAPHQL_JOBS=true
REACT_APP_USE_GRAPHQL_APPLICATIONS=true