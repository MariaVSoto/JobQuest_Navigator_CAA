# JobQuest Navigator v2 Frontend Environment Configuration
# Copy this file to .env and update with your values

# ===== API ENDPOINTS =====
# GraphQL API endpoint
REACT_APP_GRAPHQL_URL="http://localhost:8001/graphql"

# ===== FEATURE FLAGS =====
# Enable FastAPI backend features
REACT_APP_USE_FASTAPI_JOBS=true
REACT_APP_USE_FASTAPI_AUTH=true

# ===== ENVIRONMENT SETTINGS =====
REACT_APP_ENV="development"
REACT_APP_DEBUG_MODE=true

# ===== AUTHENTICATION =====
# Token storage key (for localStorage)
REACT_APP_TOKEN_KEY="jobquest_auth_token"

# ===== DEVELOPMENT SETTINGS =====
# Hot reload and development features
FAST_REFRESH=true
GENERATE_SOURCEMAP=true

# ===== BUILD SETTINGS =====
# Set to false in production for smaller bundle size
REACT_APP_ENABLE_MOCK_DATA=true

# ===== OPTIONAL FEATURES =====
# Enable additional logging in development
REACT_APP_VERBOSE_LOGGING=true