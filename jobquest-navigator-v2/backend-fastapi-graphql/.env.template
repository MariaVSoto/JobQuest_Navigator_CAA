# JobQuest Navigator v2 Backend Environment Configuration
# Copy this file to .env and update with your values

# ===== APPLICATION SETTINGS =====
DEBUG=true
PROJECT_NAME="JobQuest Navigator v2"
VERSION="2.0.0"
SECRET_KEY="your-secret-key-change-in-production"

# ===== DATABASE CONFIGURATION =====
# PostgreSQL connection string for async SQLAlchemy
DATABASE_URL="postgresql+asyncpg://jobquest_user:jobquest_password_2024@localhost:5433/jobquest_navigator_v2"

# ===== CORS SETTINGS =====
# Comma-separated list of allowed origins
ALLOWED_HOSTS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# ===== AUTHENTICATION SETTINGS =====
# JWT settings
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Cognito settings
AWS_REGION="us-east-1"
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""

# ===== EXTERNAL SERVICES =====
# OpenAI API for AI features
OPENAI_API_KEY=""

# ===== FILE STORAGE =====
# AWS S3 settings
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME="jobquest-resumes"
AWS_S3_REGION_NAME="us-east-1"

# ===== MIGRATION SETTINGS =====
# Django GraphQL endpoint (for migration phase only)
DJANGO_GRAPHQL_ENDPOINT="http://localhost:8000/graphql/"

# ===== DEVELOPMENT SETTINGS =====
# Set to false in production
UVICORN_RELOAD=true
UVICORN_HOST="0.0.0.0"
UVICORN_PORT=8000