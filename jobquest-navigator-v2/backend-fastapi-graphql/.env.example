# JobQuest Navigator v2 - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobquest

# Redis Configuration  
REDIS_URL=redis://localhost:6379/0

# Security Settings (CRITICAL: Change these values!)
SECRET_KEY=your-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Cognito Configuration (CRITICAL: Replace with your actual values!)
AWS_REGION=us-east-1
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your-user-pool-id-here
COGNITO_CLIENT_ID=your-client-id-here
COGNITO_APP_CLIENT_ID=your-client-id-here

# External API Keys
OPENAI_API_KEY=your-openai-api-key-here

# AWS S3 Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-key-here
AWS_STORAGE_BUCKET_NAME=jobquest-resumes
AWS_S3_REGION_NAME=us-east-1

# Application Settings
DEBUG=true
PROJECT_NAME=JobQuest Navigator v2
VERSION=2.0.0

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Django Proxy (for migration phase)
DJANGO_GRAPHQL_ENDPOINT=http://localhost:8000/graphql/

# Security Note:
# - Never commit .env file to version control
# - Use strong, unique values for all credentials
# - Rotate credentials regularly in production
# - Store production credentials in secure vault systems