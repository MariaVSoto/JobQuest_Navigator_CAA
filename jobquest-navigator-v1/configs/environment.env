# JobQuest Navigator Production Environment Variables
# Copy this file to .env and fill in your actual values

# =================================================================
# AWS Configuration
# =================================================================
AWS_ACCOUNT_ID=123456789012
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# =================================================================
# Django Configuration
# =================================================================
DJANGO_SECRET_KEY=your_very_secure_secret_key_here_change_this_in_production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,your-api-gateway-url.amazonaws.com

# =================================================================
# Database Configuration
# =================================================================
RDS_HOSTNAME=jobquest-navigator-db.cluster-xxxxx.us-east-1.rds.amazonaws.com
RDS_DB_NAME=jobquest_navigator
RDS_USERNAME=admin
RDS_PASSWORD=your_secure_database_password_here
RDS_PORT=3306

# =================================================================
# AWS S3 Configuration
# =================================================================
AWS_STORAGE_BUCKET_NAME=jobquest-navigator-static
AWS_S3_REGION_NAME=us-east-1

# =================================================================
# Email Configuration (AWS SES)
# =================================================================
AWS_SES_REGION_NAME=us-east-1
AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# =================================================================
# CORS Configuration
# =================================================================
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://your-cloudfront-domain.cloudfront.net

# =================================================================
# Security Configuration
# =================================================================
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://your-cloudfront-domain.cloudfront.net

# =================================================================
# Monitoring and Alerting
# =================================================================
ALERT_EMAIL=your-email@domain.com
PROJECT_OWNER=Your Name

# =================================================================
# Optional: Third-party Integrations
# =================================================================
# OpenAI API Key for AI features (if used)
OPENAI_API_KEY=your_openai_api_key_here

# Adzuna API for job data (if used)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# Google Maps API for geolocation (if used)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =================================================================
# Development/Testing Configuration (Remove in production)
# =================================================================
# LOCALSTACK_HOSTNAME=localhost
# AWS_ENDPOINT_URL=http://localhost:4566