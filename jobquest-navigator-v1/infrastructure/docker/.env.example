# JobQuest Navigator Docker Environment Configuration
# Copy this file to .env and configure your values

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=postgresql://jobquest_user:jobquest_password@database:5432/jobquest_navigator
POSTGRES_DB=jobquest_navigator
POSTGRES_USER=jobquest_user
POSTGRES_PASSWORD=jobquest_password

# ==============================================
# Redis Configuration
# ==============================================
REDIS_URL=redis://redis:6379/0

# ==============================================
# Django Configuration
# ==============================================
SECRET_KEY=django-insecure-local-development-key-change-in-production
DEBUG=1
DJANGO_SETTINGS_MODULE=core.settings_docker
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# ==============================================
# CORS Configuration
# ==============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ==============================================
# React Configuration
# ==============================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development

# ==============================================
# Email Configuration
# ==============================================
# Set to 1 to use MailHog for email testing
USE_MAILHOG=1
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Production email settings (when not using MailHog)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ==============================================
# AI Configuration (Optional)
# ==============================================
# OpenAI API key for AI features
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================
# Storage Configuration (Optional)
# ==============================================
# MinIO S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=jobquest-media

# AWS S3 (for production-like testing)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# ==============================================
# Search Configuration (Optional)
# ==============================================
# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# ==============================================
# Monitoring Configuration (Optional)
# ==============================================
# Prometheus & Grafana
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_PASSWORD=admin123

# ==============================================
# Development Tools
# ==============================================
# Debug toolbar (Django)
ENABLE_DEBUG_TOOLBAR=1

# Jupyter notebook (if using)
JUPYTER_PORT=8888
JUPYTER_TOKEN=your-jupyter-token

# ==============================================
# Security Settings
# ==============================================
# SSL/TLS (for production-like testing)
USE_SSL=0
SSL_REDIRECT=0

# Session security
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=DEBUG
DJANGO_LOG_LEVEL=INFO

# ==============================================
# Performance Settings
# ==============================================
# Gunicorn workers (for production mode)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Database connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# ==============================================
# Feature Flags
# ==============================================
# Enable/disable features for testing
ENABLE_AI_FEATURES=1
ENABLE_GEOLOCATION=1
ENABLE_COMPANY_RESEARCH=1
ENABLE_RESUME_BUILDER=1

# ==============================================
# Third-party APIs (for testing)
# ==============================================
# Job board APIs
ADZUNA_API_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-app-key

# Google Maps API (for location features)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ==============================================
# Backup Configuration
# ==============================================
# Database backup settings
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=/app/backups