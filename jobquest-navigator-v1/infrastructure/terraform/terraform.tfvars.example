# JobQuest Navigator - Terraform Variables Example
# Copy this file to terraform.tfvars and customize the values

# =================================================================
# Basic Configuration
# =================================================================
project_name = "jobquest-navigator"
environment  = "production"
aws_region   = "us-east-1"
project_owner = "Your Name"

# REQUIRED: Email for CloudWatch alerts
alert_email = "your-email@domain.com"

# =================================================================
# Network Configuration
# =================================================================
vpc_cidr = "10.0.0.0/16"

# =================================================================
# Database Configuration
# =================================================================
db_instance_class     = "db.t3.micro"        # Cost-optimized for development
db_allocated_storage  = 20                   # GB
db_name              = "jobquest_navigator"
db_username          = "admin"

# Database optimization
enable_rds_deletion_protection = false       # Set to true for production
rds_backup_retention_period   = 7           # Days
enable_multi_az               = false        # Set to true for production HA
enable_rds_encryption         = true

# =================================================================
# Lambda Configuration
# =================================================================
lambda_memory_size = 512                     # MB
lambda_timeout     = 300                     # Seconds (5 minutes)

# =================================================================
# S3 Configuration
# =================================================================
enable_s3_versioning          = true
enable_s3_encryption          = true
s3_lifecycle_expiration_days  = 90

# CORS settings for frontend-backend communication
cors_allowed_origins = ["*"]                 # Restrict this in production
cors_allowed_methods = ["GET", "PUT", "POST", "DELETE", "HEAD"]
cors_max_age_seconds = 3600

# =================================================================
# Monitoring Configuration
# =================================================================
enable_detailed_monitoring = false           # Set to true for production
log_retention_days         = 14              # CloudWatch log retention

# Alarm thresholds
rds_cpu_threshold        = 80               # Percentage
lambda_error_threshold   = 10               # Count
lambda_duration_threshold = 10000           # Milliseconds

# =================================================================
# Cost Optimization Features
# =================================================================
# VPC Features (increase cost but improve security/performance)
enable_nat_gateway = false                   # Set to true if Lambda needs internet access
enable_s3_endpoint = true                    # Reduces data transfer costs

# CloudFront (improves performance but adds complexity)
enable_cloudfront = false                    # Set to true for global distribution

# Monitoring Features
enable_flow_logs = false                     # Set to true for network debugging

# =================================================================
# Feature Flags
# =================================================================
# Set to false if you want to manage Lambda/API Gateway with Zappa
create_api_gateway    = true
create_lambda_function = true

# =================================================================
# Environment-Specific Overrides
# =================================================================

# For Development Environment:
# environment = "development"
# db_instance_class = "db.t3.micro"
# enable_rds_deletion_protection = false
# rds_backup_retention_period = 1
# lambda_memory_size = 256
# log_retention_days = 7

# For Staging Environment:
# environment = "staging"
# db_instance_class = "db.t3.small"
# enable_rds_deletion_protection = false
# rds_backup_retention_period = 3
# lambda_memory_size = 512

# For Production Environment:
# environment = "production"
# db_instance_class = "db.t3.small"  # or larger based on needs
# enable_rds_deletion_protection = true
# enable_multi_az = true
# rds_backup_retention_period = 30
# lambda_memory_size = 1024
# enable_detailed_monitoring = true
# log_retention_days = 30
# cors_allowed_origins = ["https://yourdomain.com"]

# =================================================================
# Regional Considerations
# =================================================================

# US East 1 (Virginia) - Cheapest, most services
# aws_region = "us-east-1"

# US West 2 (Oregon) - Good performance for West Coast
# aws_region = "us-west-2"

# EU West 1 (Ireland) - Good for European users
# aws_region = "eu-west-1"

# =================================================================
# Security Considerations
# =================================================================

# For production, consider:
# - Restricting cors_allowed_origins to your domain
# - Enabling enable_rds_encryption = true
# - Setting enable_rds_deletion_protection = true
# - Using smaller, specific CIDR blocks
# - Enabling enable_flow_logs = true for auditing

# =================================================================
# Cost Monitoring
# =================================================================

# Estimated monthly costs with default settings:
# - RDS db.t3.micro: ~$15/month
# - Lambda (1M requests): ~$2/month
# - S3 (5GB): ~$0.12/month
# - Data transfer: ~$0.90/month
# - CloudWatch: ~$0.50/month
# Total: ~$18-25/month

# To reduce costs:
# - Use db.t3.micro for database
# - Keep lambda_memory_size at 512MB or lower
# - Enable lifecycle policies for S3
# - Disable detailed monitoring for development
# - Use shorter log retention periods