# JobQuest Navigator Backend Environment Configuration
# SECURITY WARNING: Copy this file to .env and set your actual values
# NEVER commit .env file to version control

# Django Core Settings
DEBUG=True
SECRET_KEY=your-django-secret-key-here-generate-a-new-one
DATABASE_URL=sqlite:///db.sqlite3
LOG_LEVEL=INFO

# API Keys - Replace with your actual keys after revoking the exposed ones
OPENAI_API_KEY=sk-your-new-openai-api-key-here
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-new-adzuna-app-key

# API Usage Limits and Monitoring
OPENAI_DAILY_TOKEN_LIMIT=100000
OPENAI_DAILY_COST_LIMIT=50.00
ADZUNA_DAILY_REQUEST_LIMIT=1000
RATELIMIT_ENABLE=True

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://127.0.0.1:6379/1

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# AWS S3 Configuration (optional)
USE_S3=False
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Email Configuration (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# Additional API Keys (optional)
# GOOGLE_API_KEY=your-google-api-key