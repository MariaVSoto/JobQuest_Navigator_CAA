# JobQuest Navigator Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# Django Backend Configuration
# =============================================================================

# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-django-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/jobquest_navigator
# For SQLite (development only): DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# API Keys and External Services
# =============================================================================

# OpenAI API (for AI-powered features)
OPENAI_API_KEY=your-openai-api-key-here

# Google Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_JOBS_API_KEY=your-google-jobs-api-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# LinkedIn API (for company research)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_API_KEY=your-linkedin-api-key

# Additional AI Services (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# =============================================================================
# Authentication & Security
# =============================================================================

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-different-from-django-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 days in seconds

# CORS Settings (adjust for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Email Configuration
# =============================================================================

# Email Backend (for notifications and password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@jobquest-navigator.com

# =============================================================================
# File Storage & Media
# =============================================================================

# Local Storage (development)
MEDIA_URL=/media/
MEDIA_ROOT=media/
STATIC_URL=/static/
STATIC_ROOT=staticfiles/

# AWS S3 (production - optional)
# USE_S3=False
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# Logging & Monitoring
# =============================================================================

# Sentry (error tracking - optional)
# SENTRY_DSN=your-sentry-dsn-url

# Log Level
LOG_LEVEL=INFO

# =============================================================================
# GraphQL Configuration
# =============================================================================

# GraphQL Settings
GRAPHQL_ENDPOINT=http://localhost:8000/graphql/
GRAPHIQL_ENABLED=True  # Set to False in production

# =============================================================================
# Celery Configuration (for background tasks)
# =============================================================================

# Celery Broker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =============================================================================
# Development Tools
# =============================================================================

# Django Debug Toolbar (development only)
USE_DEBUG_TOOLBAR=True

# Django Extensions (development only)
USE_DJANGO_EXTENSIONS=True

# =============================================================================
# Production Settings (uncomment and configure for production)
# =============================================================================

# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True