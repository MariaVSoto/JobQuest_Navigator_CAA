        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminUpdateUserAttributes",
        "cognito-idp:ListUsers"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:cognito-idp:us-east-1:039444453392:userpool/us-east-1_YTV1dt2fU"
      ]
    }
  ]
